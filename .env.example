# StockSense environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Email (Gmail) ---
# Use a Gmail App Password: Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_HOST_USER=your_gmail_address@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_app_password

# --- Django core ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change_me
DJANGO_DEBUG=True

# Comma-separated list. Leave empty in development; set your own domain in production.
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HTTPS_ONLY=False

# --- Database (production, optional) ---
# Set DATABASE_URL to a Postgres connection string on your host.
# When unset, the app falls back to the local SQLite file (development).
# DATABASE_URL=postgres://user:password@host:5432/stocksense
